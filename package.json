{
  "name": "advent-of-code",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "day": "bun src/main.ts",
    "today": "bun src/main.ts --today",
    "scaffold": "bun src/scaffold.ts",
    "test": "bun src/main.ts --test",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2"
  }
}
