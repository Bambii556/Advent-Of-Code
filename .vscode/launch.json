{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bun: Run Current Day",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/src/main.ts",
      "args": ["2025", "12"],
      "cwd": "${workspaceFolder}",
      "attachSimplePort": 9229,
      "console": "integratedTerminal"
    },
    {
      "name": "Bun: Run Specific Day",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/src/main.ts",
      "args": ["2024", "${input:dayNumber}"],
      "cwd": "${workspaceFolder}",
      "attachSimplePort": 9229,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "yearNumber",
      "type": "promptString",
      "description": "Enter the Year (2020-2025)",
      "default": "2025"
    },
    {
      "id": "dayNumber",
      "type": "promptString",
      "description": "Enter the day number (1-25)",
      "default": "1"
    }
  ]
}
